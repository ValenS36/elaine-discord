DISCORD_TOKEN=ISI_TOKEN_DISCORD
# Bisa memakai CHANNEL_ID yang sama dari bot v1.
CHANNEL_ID=ISI_ID_CHANNEL
AI_API_KEY=ISI_API_KEY
AI_BASE_URL=https://api.naelle-card.my.id/v1
# Gunakan ID model Sonnet yang benar dari dashboard penyedia.
AI_MODEL=ISI_ID_MODEL_DARI_PROVIDER
# json adalah jalur kompatibel default. tools hanya jika provider mendukung function calling.
AI_MODE=json
DB_PATH=data/elaine_v2.sqlite3
DEFAULT_TIMEZONE=Asia/Jakarta
CHAT_MODE=auto
HISTORY_SYNC_LIMIT=100
CONTEXT_CHARS=18000
COOLDOWN_SECONDS=5
AI_CONCURRENCY=2
ALARM_INTERVAL_SECONDS=300
ALARM_MAX_SENDS=3
SCHEDULER_SECONDS=5
# Pemilik akses admin tetap dicek dari Manage Server Discord.
